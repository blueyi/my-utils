# npm registry (npmmirror). Linked as ~/.npmrc.
# Override one install: npm install --registry=https://registry.npmjs.org <pkg>
# Disable: unlink ~/.npmrc  (MY_UTILS_MIRRORS=off does not affect this file)
# Electron / Playwright / node-sass mirrors are env vars in config/mirrors.bash
# (npm 11 rejects those keys in npmrc).
#
# User-level global prefix (avoids EACCES on apt/dnf node writing /usr/local).
# PATH: config/resetrc.bash adds ~/.npm-global/bin when the dir exists.

registry=https://registry.npmmirror.com
prefix=${HOME}/.npm-global
