# config/env.rc.example — machine-local shell overrides (copy → config/env.rc, gitignored).
#   ./bootstrap.sh --tools links --yes
#   ./myu vault backup          # commit only privacy/env.rc.enc
#
# Symlink: ~/.env.rc → config/env.rc
# Loaded by resetrc.bash (bash + zsh) before proxy / PATH.
#
# Hermes agent keys stay in ~/.hermes/.env (private git). Do not edit that tree from here.
# This file holds Claude Code + Codex shell BYOK used by the interactive shell.

# =============================================================================
# Proxy (opt-in; default off)
# =============================================================================
# export MY_UTILS_PROXY=on
# export MY_UTILS_PROXY_PORT=7897
# export MY_UTILS_PROXY_HOST=172.28.112.1
# export PROXY_IP=http://127.0.0.1:7897

# =============================================================================
# Claude Code — OpenLux (Anthropic-compatible BYOK)
# Gateway discovery lists OpenLux models (opus/fable/sonnet/haiku, …).
# Aligns with ~/.claude/settings.json when using api.openlux.ai.
# =============================================================================
export HERMES_OPENLUX_API_KEY=""   # fill: OpenLux / Hermes OpenLux key
export ANTHROPIC_BASE_URL="https://api.openlux.ai"
export ANTHROPIC_AUTH_TOKEN="${HERMES_OPENLUX_API_KEY:-}"
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="claude-opus-5"
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5"
export ANTHROPIC_DEFAULT_FABLE_MODEL="claude-fable-5-1"
export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-5"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5-20251001"
export ANTHROPIC_SMALL_FAST_MODEL="claude-haiku-4-5-20251001"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
export ANTHROPIC_CUSTOM_MODEL_OPTION="claude-fable-5-1"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="Claude Fable 5.1 (OpenLux)"
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="OpenLux strongest Claude reasoning/agent model"

# Optional: OneRouter instead of OpenLux (comment OpenLux block above first)
# export HERMES_ONEROUTER_API_KEY=""
# export ANTHROPIC_BASE_URL="https://www.onerouter.one"
# export ANTHROPIC_AUTH_TOKEN="${HERMES_ONEROUTER_API_KEY:-}"
# export ANTHROPIC_CUSTOM_MODEL_OPTION="gpt-6-astra"
# export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="GPT-6 Astra (OneRouter)"
# export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="OneRouter alternate model gpt-6-astra"

# =============================================================================
# Codex (OpenAI-compatible BYOK)
# =============================================================================
export OPENAI_BASE_URL=""        # e.g. https://openrouter.ai/api/v1  or provider gateway
export OPENAI_API_KEY=""         # Codex / openai CLI
# Optional aliases some tools read:
# export OPENROUTER_API_KEY=""
# export CODEX_API_KEY="${OPENAI_API_KEY:-}"
