# config/env.rc.example — template for machine-local secrets / AI BYOK.
# Copy to config/env.rc (gitignored), fill keys, then:
#   ./bootstrap.sh --tools links --yes
#   ./myu vault backup
#
# Symlink: ~/.env.rc → config/env.rc (common/link.ini)
# Loaded early by config/resetrc.bash (bash + zsh).

# =============================================================================
# Proxy (opt-in; default off in config/proxy.bash)
# =============================================================================
# export MY_UTILS_PROXY=on
# export MY_UTILS_PROXY_PORT=7897
# export MY_UTILS_PROXY_HOST=172.28.112.1
# export PROXY_IP=http://127.0.0.1:7897

# =============================================================================
# Claude Code / Anthropic BYOK (shell exports — do not put secrets in _zshrc)
# =============================================================================
export ANTHROPIC_BASE_URL="https://www.onerouter.one"
# Prefer setting the provider key below; AUTH_TOKEN can mirror it:
export HERMES_ONEROUTER_API_KEY=""
export ANTHROPIC_AUTH_TOKEN="${HERMES_ONEROUTER_API_KEY:-}"
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="claude-opus-5"
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5"
export ANTHROPIC_SMALL_FAST_MODEL="claude-haiku-4-5-20251001"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
export ANTHROPIC_CUSTOM_MODEL_OPTION="gpt-6-astra"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="GPT-6 Astra (OneRouter)"
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="OneRouter alternate model gpt-6-astra"

# =============================================================================
# Other AI / search provider keys (optional; used by CLI agents & tools)
# =============================================================================
# export OPENROUTER_API_KEY=""
# export OPENAI_API_KEY=""
# export DEEPSEEK_API_KEY=""
# export HERMES_OPENLUX_API_KEY=""
# export HERMES_AGISILICON_API_KEY=""
# export HERMES_VOLCEENGINE_API_KEY=""
# export HERMES_CLOUDSWAY_API_KEY=""
# export FAL_KEY=""
# export TAVILY_API_KEY=""
# export BRAVE_API_KEY=""
# export BRAVE_SEARCH_API_KEY=""
# export GITHUB_TOKEN=""
