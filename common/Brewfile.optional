# Optional macOS Homebrew Bundle entries (not installed by default).
# Core set: common/Brewfile
#
# Install:
#   brew bundle --file=common/Brewfile.optional
#   # or:
#   ./bootstrap.sh --tools packages --optional --yes
#
# App Store lines still need a signed-in Apple ID.

