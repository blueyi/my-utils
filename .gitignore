*.log
*.pyc
common/*.pyc
common/.ropeproject


# Cursor session / user data (keep settings.json, mcp.json, rules/)
cursor_bak/User/History/
cursor_bak/User/globalStorage/
cursor_bak/User/workspaceStorage/
# Cursor projects: ephemeral per-workspace data
# Real MCP user config lives in cursor_bak/User/mcp.json (not projects/*/mcps schema caches)
cursor_bak/projects/*/terminals/
cursor_bak/projects/*/agent-transcripts/
cursor_bak/projects/*/agent-tools/
cursor_bak/projects/*/worker.log
cursor_bak/projects/*/.workspace-trusted
cursor_bak/projects/*/canvases/node_modules/
# Cursor auto-generates identical tsconfig per workspace canvases dir
cursor_bak/projects/*/canvases/tsconfig.json
cursor_bak/projects/*/mcps/
cursor_bak/projects/.agent-data-cleanup-*
# macOS temp workspace dirs (var-folders-*), not meaningful to version
cursor_bak/projects/var-folders-*/

# Binary files and tools
bin/
*.o
*.a
*.so
*.dylib

# Build artifacts
build/
dist/
*.egg-info/
__pycache__/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
.env.local
common/ssServerInstall.py

# my-utils env backup artifacts (must stay out of git)
tools/env_sync/tmp/
*.env.rc.enc
*.envrc.enc
